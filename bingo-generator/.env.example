# Copy to .env and fill in. Never commit the real .env.

# --- Google OAuth 2.0 -------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> Create credentials
#   -> OAuth client ID -> Web application
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Public origin of the app. Also decides the session cookie's Secure flag:
# an https:// value turns it on unless SESSION_COOKIE_SECURE overrides it.
APP_BASE_URL=http://127.0.0.1:8000

# --- Roles ------------------------------------------------------------------
# Comma-separated Google accounts that are promoted to admin on sign-in.
# Admins can see every sheet; everyone else only sees sheets assigned to them.
ADMIN_EMAILS=you@gmail.com

# --- Sessions ---------------------------------------------------------------
# Signs the HTTP-only session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# When empty a per-process key is used, so every restart signs everyone out.
SESSION_SECRET=

# Optional explicit override of the cookie Secure flag (true/false).
SESSION_COOKIE_SECURE=false

# --- Local development sign-in ----------------------------------------------
# Lets you sign in from this computer without Google. Only honoured while
# APP_BASE_URL is a plain-http loopback address (an https:// value disables it).
# The first account created this way becomes the administrator.
# Set to false to require Google even locally.
# LOCAL_LOGIN_ENABLED=true
